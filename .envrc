# direnv entry point: `direnv allow` once. Holds NO values.
use flake
dotenv_if_exists .env
dotenv_if_exists .env.local
# Per-operator overrides (gitignored, a SHELL file so it can compute rather than store), e.g.
#   (names come from pipeline.toml [consumer]; the example consumer's shown)
#   export EXAMPLE_DATA="<a data folder outside any git repo>"          # data: may sync
#   export EXAMPLE_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/scrape-harness-example"  # state: local only
#   export EX_FORBIDDEN_LITERALS="<file of literals that must never land in this repo>"
source_env_if_exists .envrc.local
