# direnv entry point: `direnv allow` once. Holds NO values. `nix run .#<cli>` loads the same files, and
# only from a checkout whose .envrc direnv allows.
use flake
dotenv_if_exists .env
dotenv_if_exists .env.local
# Per-operator overrides (gitignored, a SHELL file so it can compute rather than store), e.g. the data and
# state roots named by pipeline.toml [consumer].data_env / state_env, outside any git repo.
source_env_if_exists .envrc.local
