{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.v1.schema.json",
  "title": "run.v1",
  "description": "The record of one crawl run (runs/<run_id>.json, rewritten atomically). The requests themselves live in crawlee's persisted request queue named `queue` (dedup by unique_key), so `li crawl resume` reopens it and never re-GETs a handled request.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "command",
    "variant",
    "source",
    "created_at",
    "status",
    "challenges",
    "queue"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "run.v1"
    },
    "run_id": {
      "type": "string"
    },
    "command": {
      "enum": [
        "crawl-lists",
        "fetch-ads",
        "ab",
        "panel",
        "probe"
      ],
      "description": "ab runs are experiments and panel runs are scheduled revisits: neither is ever resumed (the next scheduled run replaces a stopped panel run); probe runs are one robots.txt GET and are never resumed either."
    },
    "variant": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "stopped",
        "aborted",
        "completed"
      ]
    },
    "challenges": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "description": "The source (site) whose pages this run fetches."
    },
    "queue": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "crawlee RequestQueue name under the STATE root ($<state_env>)/crawlee."
    },
    "egress": {
      "$ref": "#/$defs/egress"
    },
    "requests": {
      "$ref": "#/$defs/requests"
    },
    "approval_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "plan_hash",
        "approved_at",
        "expires_at"
      ],
      "description": "The operator approval this run consumed (ADR-0006).",
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "standing": {
          "const": true,
          "description": "Consumed one run of a standing (scheduled, pre-signed) approval."
        },
        "run": {
          "type": "integer",
          "minimum": 1,
          "description": "Which run of the standing approval this was (1-based)."
        },
        "refunded": {
          "const": true,
          "description": "The run was refused before any site request and its approval was refunded (approvals.refund): it no longer counts as a use."
        },
        "bounded": {
          "const": true,
          "description": "Consumed by one step of a `<cli> refresh` chain under its bounded approval."
        },
        "refresh_run": {
          "type": "string",
          "pattern": "^refresh-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$",
          "description": "bounded: the refresh run id (STATE/refresh/<id>.json)."
        },
        "step": {
          "type": "string",
          "minLength": 1,
          "description": "bounded: the refresh step."
        },
        "list_pages": {
          "type": "integer",
          "minimum": 0,
          "description": "bounded: the most list pages this step may send (counted against the bounds)."
        },
        "ad_requests": {
          "type": "integer",
          "minimum": 0,
          "description": "bounded: the ad requests this step sends (counted against the bounds)."
        },
        "list_set": {
          "type": "integer",
          "minimum": 0,
          "description": "bounded crawl-lists: the index of the signed list set this step crawled."
        }
      },
      "dependentRequired": {
        "standing": [
          "run"
        ],
        "run": [
          "standing"
        ],
        "bounded": [
          "refresh_run",
          "step",
          "list_pages",
          "ad_requests"
        ],
        "refresh_run": [
          "bounded"
        ]
      }
    },
    "log_ref": {
      "type": "string",
      "pattern": "^runs/[^/]+\\.log\\.jsonl$",
      "description": "The run's live JSON-lines log, relative to the data dir (ADR-0007)."
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "seed",
        "stratify",
        "allocation",
        "subcategories",
        "strata"
      ],
      "description": "fetch-ads --sample: the design of this run's depth-stratified ad sample (H4).",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "stratify": {
          "const": "depth"
        },
        "allocation": {
          "enum": [
            "equal",
            "proportional"
          ]
        },
        "subcategories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "strata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stratum"
          }
        },
        "manifest": {
          "type": "string",
          "pattern": "^derived/samples/[^/]+\\.jsonl$"
        },
        "select": {
          "enum": [
            "refetch",
            "recruit"
          ],
          "description": "recruit: a one-off sample of ads seen on list cards but never opened (fetch-ads --select recruit)."
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "command",
        "purpose",
        "stage",
        "inputs",
        "outputs",
        "scale",
        "triggered_by",
        "live_log",
        "roots"
      ],
      "description": "The run card printed at the start of the run (ADR-0011).",
      "properties": {
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "pattern": "^([0-9]+/[0-9]+|utility)$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scale": {
          "type": "object"
        },
        "triggered_by": {
          "type": "object"
        },
        "live_log": {
          "type": [
            "object",
            "null"
          ]
        },
        "roots": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Each root named on the card, as an absolute path (shown once)."
        },
        "mode": {
          "enum": [
            "run",
            "plan",
            "dry-run"
          ]
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "choice"
      ],
      "description": "The run's ONE proxy (never credentials): chosen at --plan, signed in the plan, kept on resume.",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^http://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*:[0-9]{2,5}$"
        },
        "choice": {
          "enum": [
            "random",
            "round_robin",
            "only"
          ]
        }
      }
    },
    "supersedes": {
      "type": "string",
      "description": "The stopped run whose pending requests this run took over (fetch-ads --supersede); that run gets a `superseded` event naming this one."
    },
    "supersede_scope": {
      "type": "string",
      "enum": [
        "pending",
        "failed"
      ],
      "description": "What this run took over from the run it supersedes: its pending ad requests, or (fetch-ads --supersede --failed) its failed ones. Each scope is taken over once. Absent on runs before the field: those took the pending ones."
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "status",
        "latency_ms",
        "egress_country",
        "verdict",
        "reason"
      ],
      "description": "probe robots: the ONE GET's outcome. Markers describe the body; the body itself is never stored here.",
      "properties": {
        "url": {
          "type": "string"
        },
        "status": {
          "type": [
            "integer",
            "null"
          ],
          "description": "HTTP status; null when no response came"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "egress_country": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "enum": [
            "clean",
            "not_clean",
            "unreachable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "null when clean; a challenge.detect() code, http_<status>, unexpected_page, or the error type"
        },
        "markers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "robots_records",
            "html",
            "content_type",
            "bytes"
          ],
          "properties": {
            "robots_records": {
              "type": "integer",
              "minimum": 0
            },
            "html": {
              "type": "boolean"
            },
            "content_type": {
              "type": [
                "string",
                "null"
              ]
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loc",
        "checked_at",
        "trace_url"
      ],
      "description": "Where this machine's traffic left from, per Cloudflare's trace endpoint, checked before the run. The public IP is deliberately not recorded.",
      "properties": {
        "loc": {
          "type": "string",
          "pattern": "^[A-Za-z]{2}$"
        },
        "colo": {
          "type": "string"
        },
        "warp": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "trace_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "requests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list_pages",
        "ad_pages",
        "robots",
        "other",
        "egress_trace"
      ],
      "description": "Requests this run sent, counted at the backend layer (every attempt, retries included). list_pages/ad_pages are page GETs (navigations), robots and other go through the HTTP client; with a browser backend, site_subresources/third_party/redirects count what each page load sent besides its GET. egress_trace goes to the egress-check endpoint, never the site. failed_before_request counts attempts that errored before sending anything.",
      "properties": {
        "list_pages": {
          "type": "integer",
          "minimum": 0
        },
        "ad_pages": {
          "type": "integer",
          "minimum": 0
        },
        "robots": {
          "type": "integer",
          "minimum": 0
        },
        "other": {
          "type": "integer",
          "minimum": 0
        },
        "egress_trace": {
          "type": "integer",
          "minimum": 0
        },
        "site_subresources": {
          "type": "integer",
          "minimum": 0,
          "description": "Browser requests to the site's host or its subdomains other than the page GET (CSS, JS, images, XHR; disk-cache hits included)."
        },
        "third_party": {
          "type": "integer",
          "minimum": 0,
          "description": "Browser requests to any other host (incl. iframes)."
        },
        "redirects": {
          "type": "integer",
          "minimum": 0,
          "description": "Main-frame redirect hops after a page GET."
        },
        "failed_before_request": {
          "type": "integer",
          "minimum": 0,
          "description": "Attempts that errored before any GET (e.g. the browser failed to launch): zero requests."
        },
        "site_subresources_blocked": {
          "type": "integer",
          "minimum": 0,
          "description": "Of site_subresources, those the browser blocked ([crawl] block_extensions): attempted, never sent. Sent = site_subresources - site_subresources_blocked (crawl.sent)."
        },
        "third_party_blocked": {
          "type": "integer",
          "minimum": 0,
          "description": "Of third_party, those the browser blocked (tracker lists, or a block_extensions match): attempted, never sent."
        },
        "site_subresources_answered": {
          "type": "integer",
          "minimum": 0,
          "description": "Of site_subresources, image requests the browser answered itself with a placeholder ([crawl] image_mode answer): attempted, never sent."
        },
        "third_party_answered": {
          "type": "integer",
          "minimum": 0,
          "description": "Of third_party, image requests the browser answered itself: attempted, never sent."
        },
        "trackers_blocked": {
          "type": "integer",
          "minimum": 0,
          "description": "Of third_party_blocked, those EasyList/EasyPrivacy blocked (trackers.py): attempted, never sent."
        }
      }
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subcategory",
        "decile",
        "population",
        "sampled",
        "weight"
      ],
      "properties": {
        "subcategory": {
          "type": "string"
        },
        "decile": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9
        },
        "population": {
          "type": "integer",
          "minimum": 0
        },
        "sampled": {
          "type": "integer",
          "minimum": 0
        },
        "weight": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
